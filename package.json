{
  "name": "jev-router",
  "version": "0.1.0",
  "description": "Local Anthropic-compatible gateway that uses TypeSafe JEV (System One) to send simple Claude Code work to a cheap OpenAI-compatible provider and keep the Claude quota for heavy lifting.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/cli.js",
  "bin": {
    "jev-router": "dist/cli.js"
  },
  "files": [
    "dist",
    ".env.example"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "stats": "node dist/cli.js stats",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "coverage": "node --import tsx --test --experimental-test-coverage test/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
